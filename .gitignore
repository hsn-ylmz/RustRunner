# =============================================================================
# RustRunner .gitignore
# =============================================================================

# Rust
# Cargo.lock is intentionally tracked: rustrunner ships as a binary, so the
# lockfile is what makes CI and release builds reproducible.
/RustRunner/target/
**/*.rs.bk

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Electron
/RustRunner-Desktop/release/
/RustRunner-Desktop/dist/
/RustRunner-Desktop/.erb/dll/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Runtime
/RustRunner/runtime/micromamba
.rustrunner/

# Logs
*.log

# Build artifacts
*.exe
*.dmg
*.AppImage
*.deb
*.rpm

# Personal notes (not user-facing)
/ROADMAP.md

# Example workflow outputs
examples/out/

# Local agent tooling and generated analysis (never published)
/.claude/
/CLAUDE.md
/reports/

# graphify: publish the graph itself, not the machine-local cache or the
# dated backup snapshots it writes on every update.
/graphify-out/cache/
/graphify-out/.graphify_python
/graphify-out/20*/
