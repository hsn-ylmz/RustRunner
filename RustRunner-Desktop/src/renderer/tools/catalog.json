{
  "schema_version": 2,
  "version": "2026.11.0",
  "file_types": [
    "fastq",
    "fasta",
    "sam",
    "bam",
    "bai",
    "vcf",
    "gtf",
    "tsv",
    "txt",
    "html",
    "zip",
    "json",
    "index"
  ],
  "categories": {
    "qc": {
      "label": "Quality control",
      "color": "mint"
    },
    "trimming": {
      "label": "Trimming",
      "color": "sand"
    },
    "alignment": {
      "label": "Alignment",
      "color": "sky"
    },
    "processing": {
      "label": "BAM processing",
      "color": "lilac"
    },
    "variant_calling": {
      "label": "Variant calling",
      "color": "peach"
    },
    "quantification": {
      "label": "Quantification",
      "color": "lemon"
    }
  },
  "tools": [
    {
      "id": "fastqc",
      "name": "FastQC",
      "description": "Quality report for raw sequencing reads.",
      "category": "qc",
      "subcategory": "Read quality",
      "install": {
        "kind": "conda",
        "package": "fastqc",
        "channel": "bioconda",
        "version": "0.13.0"
      },
      "inputs": [
        {
          "name": "reads",
          "label": "Reads",
          "description": "One or more FASTQ files (plain or .gz). Each gets its own report.",
          "types": [
            "fastq"
          ],
          "required": true,
          "multiple": true,
          "example": "reads.fastq.gz"
        }
      ],
      "outputs": [
        {
          "name": "report_dir",
          "label": "Report folder",
          "description": "FastQC writes one HTML report and one zip per input file here.",
          "types": [
            "html",
            "zip"
          ],
          "pattern": "qc/",
          "is_dir": true
        }
      ],
      "params": [],
      "command": "fastqc -t {threads} --outdir {report_dir} {reads}",
      "threads": 2,
      "docs": "https://www.bioinformatics.babraham.ac.uk/projects/fastqc/"
    },
    {
      "id": "multiqc",
      "name": "MultiQC",
      "description": "Combines the reports of many tools into one HTML page.",
      "category": "qc",
      "subcategory": "Report summaries",
      "install": {
        "kind": "conda",
        "package": "multiqc",
        "channel": "bioconda",
        "version": "1.35"
      },
      "inputs": [
        {
          "name": "reports",
          "label": "Reports to combine",
          "description": "Any results MultiQC understands: FastQC, fastp, Cutadapt, samtools, STAR, Salmon, featureCounts. Connect as many steps as you like.",
          "types": [
            "any"
          ],
          "required": true,
          "multiple": true,
          "example": "qc/"
        }
      ],
      "outputs": [
        {
          "name": "report_dir",
          "label": "Report folder",
          "description": "Folder for the combined report and its data.",
          "types": [
            "html"
          ],
          "pattern": "multiqc/",
          "is_dir": true
        },
        {
          "name": "report",
          "label": "Combined report",
          "description": "The HTML page. It is always called multiqc_report.html inside the report folder.",
          "types": [
            "html"
          ],
          "derived": {
            "from": "report_dir",
            "suffix": "multiqc_report.html"
          },
          "is_dir": false
        }
      ],
      "params": [],
      "command": "multiqc --force -o {report_dir} -n multiqc_report {reports}",
      "threads": 1,
      "docs": "https://docs.seqera.io/multiqc"
    },
    {
      "id": "fastp",
      "name": "fastp",
      "description": "Fast adapter and quality trimming for FASTQ reads.",
      "category": "trimming",
      "subcategory": "Trim and filter reads",
      "install": {
        "kind": "conda",
        "package": "fastp",
        "channel": "bioconda",
        "version": "1.3.7"
      },
      "inputs": [
        {
          "name": "reads",
          "label": "Reads",
          "description": "Sequencing reads in FASTQ format (plain or .gz).",
          "types": [
            "fastq"
          ],
          "required": true,
          "multiple": false,
          "example": "reads.fastq.gz"
        }
      ],
      "outputs": [
        {
          "name": "trimmed",
          "label": "Trimmed reads",
          "description": "Reads after trimming and filtering.",
          "types": [
            "fastq"
          ],
          "pattern": "trimmed.fastq.gz",
          "is_dir": false
        },
        {
          "name": "html_report",
          "label": "HTML report",
          "description": "Before and after statistics, for people.",
          "types": [
            "html"
          ],
          "pattern": "fastp.html",
          "is_dir": false
        },
        {
          "name": "json_report",
          "label": "JSON report",
          "description": "The same statistics for MultiQC.",
          "types": [
            "json"
          ],
          "pattern": "fastp.json",
          "is_dir": false
        }
      ],
      "params": [
        {
          "id": "min_quality",
          "label": "Minimum base quality",
          "type": "number",
          "default": 15,
          "description": "Bases below this Phred quality count as unqualified.",
          "min": 0,
          "max": 60
        },
        {
          "id": "min_length",
          "label": "Minimum read length",
          "type": "number",
          "default": 15,
          "description": "Reads shorter than this after trimming are dropped.",
          "min": 0
        }
      ],
      "command": "fastp -i {reads} -o {trimmed} -w {threads} -q {min_quality} -l {min_length} --html {html_report} --json {json_report}",
      "threads": 4,
      "docs": "https://github.com/OpenGene/fastp"
    },
    {
      "id": "cutadapt",
      "name": "Cutadapt",
      "description": "Removes adapter sequences and low-quality ends from reads.",
      "category": "trimming",
      "subcategory": "Trim and filter reads",
      "install": {
        "kind": "conda",
        "package": "cutadapt",
        "channel": "bioconda",
        "version": "5.2"
      },
      "inputs": [
        {
          "name": "reads",
          "label": "Reads",
          "description": "Sequencing reads in FASTQ format (plain or .gz).",
          "types": [
            "fastq"
          ],
          "required": true,
          "multiple": false,
          "example": "reads.fastq.gz"
        }
      ],
      "outputs": [
        {
          "name": "trimmed",
          "label": "Trimmed reads",
          "description": "Reads after adapter removal.",
          "types": [
            "fastq"
          ],
          "pattern": "trimmed.fastq.gz",
          "is_dir": false
        },
        {
          "name": "report",
          "label": "Trimming report",
          "description": "Cutadapt's summary of what it removed. MultiQC reads it.",
          "types": [
            "txt"
          ],
          "pattern": "cutadapt.txt",
          "is_dir": false
        }
      ],
      "params": [
        {
          "id": "adapter",
          "label": "3' adapter sequence",
          "type": "string",
          "default": "AGATCGGAAGAGC",
          "description": "Adapter to cut from the 3' end. The default is the Illumina universal adapter.",
          "required": true
        },
        {
          "id": "min_length",
          "label": "Minimum read length",
          "type": "number",
          "default": 20,
          "description": "Reads shorter than this after trimming are discarded.",
          "min": 0
        },
        {
          "id": "quality_cutoff",
          "label": "Quality cutoff",
          "type": "number",
          "default": 20,
          "description": "Trim low-quality bases from the 3' end below this Phred score.",
          "min": 0,
          "max": 60
        }
      ],
      "command": "cutadapt -j {threads} -a {adapter} -m {min_length} -q {quality_cutoff} -o {trimmed} {reads} > {report}",
      "threads": 4,
      "docs": "https://cutadapt.readthedocs.io/"
    },
    {
      "id": "bwa-mem",
      "name": "BWA MEM",
      "description": "Aligns reads to a reference genome. Writes SAM.",
      "category": "alignment",
      "subcategory": "DNA aligners",
      "install": {
        "kind": "conda",
        "package": "bwa",
        "channel": "bioconda",
        "version": "0.7.19"
      },
      "inputs": [
        {
          "name": "ref",
          "label": "Reference genome",
          "description": "The reference FASTA the reads are aligned to. Index it first with `bwa index`; the index files sit next to it.",
          "types": [
            "fasta"
          ],
          "required": true,
          "multiple": false,
          "example": "genome.fa"
        },
        {
          "name": "reads1",
          "label": "Reads (first of the pair)",
          "description": "FASTQ with the reads, or the first file of a pair.",
          "types": [
            "fastq"
          ],
          "required": true,
          "multiple": false,
          "example": "reads_R1.fastq.gz"
        },
        {
          "name": "reads2",
          "label": "Reads (second of the pair)",
          "description": "Leave empty for single-end reads.",
          "types": [
            "fastq"
          ],
          "required": false,
          "multiple": false,
          "example": "reads_R2.fastq.gz"
        }
      ],
      "outputs": [
        {
          "name": "sam",
          "label": "Alignments",
          "description": "The alignments in SAM format.",
          "types": [
            "sam"
          ],
          "pattern": "aligned.sam",
          "is_dir": false
        }
      ],
      "params": [
        {
          "id": "mark_secondary",
          "label": "Mark shorter split hits as secondary",
          "type": "boolean",
          "default": true,
          "flag": "-M",
          "description": "Needed by Picard and GATK."
        },
        {
          "id": "min_seed_length",
          "label": "Minimum seed length",
          "type": "number",
          "default": 19,
          "description": "Matches shorter than this are dropped. Smaller is more sensitive and slower.",
          "min": 1
        }
      ],
      "command": "bwa mem -t {threads} {mark_secondary} -k {min_seed_length} {ref} {reads1} {reads2} > {sam}",
      "threads": 4,
      "docs": "https://bio-bwa.sourceforge.net/bwa.shtml"
    },
    {
      "id": "bowtie2",
      "name": "Bowtie2",
      "description": "Aligns single-end reads to an indexed genome. Writes SAM.",
      "category": "alignment",
      "subcategory": "DNA aligners",
      "install": {
        "kind": "conda",
        "package": "bowtie2",
        "channel": "bioconda",
        "version": "2.5.5"
      },
      "inputs": [
        {
          "name": "index",
          "label": "Genome index",
          "description": "The index made with `bowtie2-build`. Give its prefix: the path without .1.bt2 and the rest.",
          "types": [
            "index"
          ],
          "required": true,
          "multiple": false,
          "example": "genome_index"
        },
        {
          "name": "reads",
          "label": "Reads",
          "description": "Sequencing reads in FASTQ format (plain or .gz).",
          "types": [
            "fastq"
          ],
          "required": true,
          "multiple": false,
          "example": "reads.fastq.gz"
        }
      ],
      "outputs": [
        {
          "name": "sam",
          "label": "Alignments",
          "description": "The alignments in SAM format.",
          "types": [
            "sam"
          ],
          "pattern": "aligned.sam",
          "is_dir": false
        }
      ],
      "params": [
        {
          "id": "preset",
          "label": "Preset",
          "type": "select",
          "default": "sensitive",
          "options": [
            "very-fast",
            "fast",
            "sensitive",
            "very-sensitive"
          ],
          "description": "Speed against sensitivity."
        }
      ],
      "command": "bowtie2 -p {threads} --{preset} -x {index} -U {reads} -S {sam}",
      "threads": 4,
      "docs": "https://bowtie-bio.sourceforge.net/bowtie2/manual.shtml"
    },
    {
      "id": "star",
      "name": "STAR",
      "description": "Splice-aware RNA-seq aligner. Writes a coordinate-sorted BAM.",
      "category": "alignment",
      "subcategory": "RNA-seq aligners",
      "install": {
        "kind": "conda",
        "package": "star",
        "channel": "bioconda",
        "version": "2.7.10b",
        "osx64": true
      },
      "inputs": [
        {
          "name": "index",
          "label": "Genome index folder",
          "description": "The folder made with `STAR --runMode genomeGenerate`.",
          "types": [
            "index"
          ],
          "required": true,
          "multiple": false,
          "example": "star_index/"
        },
        {
          "name": "reads",
          "label": "Reads",
          "description": "Sequencing reads in FASTQ format (plain or .gz).",
          "types": [
            "fastq"
          ],
          "required": true,
          "multiple": false,
          "example": "reads.fastq.gz"
        }
      ],
      "outputs": [
        {
          "name": "out_dir",
          "label": "Output folder",
          "description": "STAR writes the BAM and its logs into this folder.",
          "types": [
            "bam",
            "txt"
          ],
          "pattern": "star/",
          "is_dir": true
        },
        {
          "name": "bam",
          "label": "Alignments",
          "description": "The sorted BAM. It is always called Aligned.sortedByCoord.out.bam inside the output folder.",
          "types": [
            "bam"
          ],
          "derived": {
            "from": "out_dir",
            "suffix": "Aligned.sortedByCoord.out.bam"
          },
          "is_dir": false
        },
        {
          "name": "log",
          "label": "Mapping summary",
          "description": "STAR's mapping statistics. MultiQC reads it.",
          "types": [
            "txt"
          ],
          "derived": {
            "from": "out_dir",
            "suffix": "Log.final.out"
          },
          "is_dir": false
        }
      ],
      "params": [],
      "command": "STAR --runThreadN {threads} --genomeDir {index} --readFilesIn {reads} --readFilesCommand gzip -cdf --outSAMtype BAM SortedByCoordinate --outFileNamePrefix {out_dir}",
      "threads": 8,
      "docs": "https://github.com/alexdobin/STAR/blob/master/doc/STARmanual.pdf"
    },
    {
      "id": "samtools-sort",
      "name": "samtools sort",
      "description": "Sorts alignments by coordinate (or by read name).",
      "category": "processing",
      "subcategory": "Alignment files",
      "install": {
        "kind": "conda",
        "package": "samtools",
        "channel": "bioconda",
        "version": "1.24"
      },
      "inputs": [
        {
          "name": "alignments",
          "label": "Alignments",
          "description": "A SAM or BAM file.",
          "types": [
            "sam",
            "bam"
          ],
          "required": true,
          "multiple": false,
          "example": "aligned.sam"
        }
      ],
      "outputs": [
        {
          "name": "bam",
          "label": "Sorted alignments",
          "description": "The sorted BAM.",
          "types": [
            "bam"
          ],
          "pattern": "sorted.bam",
          "is_dir": false
        }
      ],
      "params": [
        {
          "id": "by_name",
          "label": "Sort by read name",
          "type": "boolean",
          "default": false,
          "flag": "-n",
          "description": "Off sorts by genome coordinate."
        },
        {
          "id": "memory_per_thread",
          "label": "Memory per thread",
          "type": "string",
          "default": "768M",
          "description": "For example 768M or 2G."
        }
      ],
      "command": "samtools sort -@ {threads} {by_name} -m {memory_per_thread} -o {bam} {alignments}",
      "threads": 4,
      "docs": "https://www.htslib.org/doc/samtools-sort.html"
    },
    {
      "id": "samtools-index",
      "name": "samtools index",
      "description": "Builds the .bai index of a coordinate-sorted BAM.",
      "category": "processing",
      "subcategory": "Alignment files",
      "install": {
        "kind": "conda",
        "package": "samtools",
        "channel": "bioconda",
        "version": "1.24"
      },
      "inputs": [
        {
          "name": "bam",
          "label": "Alignments (BAM)",
          "description": "A BAM file.",
          "types": [
            "bam"
          ],
          "required": true,
          "multiple": false,
          "example": "sorted.bam"
        }
      ],
      "outputs": [
        {
          "name": "bai",
          "label": "BAM index",
          "description": "The .bai file.",
          "types": [
            "bai"
          ],
          "pattern": "sorted.bam.bai",
          "is_dir": false
        }
      ],
      "params": [],
      "command": "samtools index -@ {threads} {bam} {bai}",
      "threads": 2,
      "docs": "https://www.htslib.org/doc/samtools-index.html"
    },
    {
      "id": "samtools-view",
      "name": "samtools view",
      "description": "Filters alignments and converts them to BAM.",
      "category": "processing",
      "subcategory": "Alignment files",
      "install": {
        "kind": "conda",
        "package": "samtools",
        "channel": "bioconda",
        "version": "1.24"
      },
      "inputs": [
        {
          "name": "alignments",
          "label": "Alignments",
          "description": "A SAM or BAM file.",
          "types": [
            "sam",
            "bam"
          ],
          "required": true,
          "multiple": false,
          "example": "aligned.sam"
        }
      ],
      "outputs": [
        {
          "name": "filtered",
          "label": "Filtered alignments",
          "description": "The alignments that passed the filters, as BAM.",
          "types": [
            "bam"
          ],
          "pattern": "filtered.bam",
          "is_dir": false
        }
      ],
      "params": [
        {
          "id": "min_mapq",
          "label": "Minimum mapping quality",
          "type": "number",
          "default": 20,
          "description": "Alignments below this MAPQ are dropped.",
          "min": 0,
          "max": 255
        },
        {
          "id": "mapped_only",
          "label": "Keep mapped reads only",
          "type": "boolean",
          "default": true,
          "flag": "-F 4",
          "description": "Drops reads that did not align."
        }
      ],
      "command": "samtools view -@ {threads} -b -q {min_mapq} {mapped_only} -o {filtered} {alignments}",
      "threads": 2,
      "docs": "https://www.htslib.org/doc/samtools-view.html"
    },
    {
      "id": "samtools-flagstat",
      "name": "samtools flagstat",
      "description": "Counts reads by alignment flag. Writes a text summary.",
      "category": "processing",
      "subcategory": "Alignment files",
      "install": {
        "kind": "conda",
        "package": "samtools",
        "channel": "bioconda",
        "version": "1.24"
      },
      "inputs": [
        {
          "name": "alignments",
          "label": "Alignments",
          "description": "A SAM or BAM file.",
          "types": [
            "sam",
            "bam"
          ],
          "required": true,
          "multiple": false,
          "example": "aligned.sam"
        }
      ],
      "outputs": [
        {
          "name": "report",
          "label": "Summary",
          "description": "Counts of mapped, paired and duplicate reads, as text.",
          "types": [
            "txt"
          ],
          "pattern": "flagstat.txt",
          "is_dir": false
        }
      ],
      "params": [],
      "command": "samtools flagstat -@ {threads} {alignments} > {report}",
      "threads": 2,
      "docs": "https://www.htslib.org/doc/samtools-flagstat.html"
    },
    {
      "id": "bcftools-call",
      "name": "bcftools call",
      "description": "Calls SNPs and indels from a sorted BAM (mpileup then call).",
      "category": "variant_calling",
      "subcategory": "SNPs and small indels",
      "install": {
        "kind": "conda",
        "package": "bcftools",
        "channel": "bioconda",
        "version": "1.24"
      },
      "inputs": [
        {
          "name": "ref",
          "label": "Reference genome",
          "description": "The reference the reads were aligned to. It needs a .fai index (made with `samtools faidx`).",
          "types": [
            "fasta"
          ],
          "required": true,
          "multiple": false,
          "example": "genome.fa"
        },
        {
          "name": "bam",
          "label": "Alignments (BAM)",
          "description": "A coordinate-sorted BAM.",
          "types": [
            "bam"
          ],
          "required": true,
          "multiple": false,
          "example": "sorted.bam"
        }
      ],
      "outputs": [
        {
          "name": "vcf",
          "label": "Variants",
          "description": "The called variants in VCF format.",
          "types": [
            "vcf"
          ],
          "pattern": "variants.vcf",
          "is_dir": false
        }
      ],
      "params": [
        {
          "id": "min_mapq",
          "label": "Minimum mapping quality",
          "type": "number",
          "default": 20,
          "description": "Alignments below this MAPQ are ignored.",
          "min": 0,
          "max": 255
        }
      ],
      "command": "set -o pipefail; bcftools mpileup --threads {threads} -Ou -f {ref} -q {min_mapq} {bam} | bcftools call --threads {threads} -mv -Ov -o {vcf}",
      "threads": 2,
      "docs": "https://samtools.github.io/bcftools/bcftools.html"
    },
    {
      "id": "salmon-quant",
      "name": "Salmon quant",
      "description": "Quantifies transcript abundance from single-end reads.",
      "category": "quantification",
      "subcategory": "Transcript abundance",
      "install": {
        "kind": "conda",
        "package": "salmon",
        "channel": "bioconda",
        "version": "2.8.0"
      },
      "inputs": [
        {
          "name": "index",
          "label": "Salmon index",
          "description": "The folder made with `salmon index`.",
          "types": [
            "index"
          ],
          "required": true,
          "multiple": false,
          "example": "salmon_index/"
        },
        {
          "name": "reads",
          "label": "Reads",
          "description": "Sequencing reads in FASTQ format (plain or .gz).",
          "types": [
            "fastq"
          ],
          "required": true,
          "multiple": false,
          "example": "reads.fastq.gz"
        }
      ],
      "outputs": [
        {
          "name": "out_dir",
          "label": "Result folder",
          "description": "Salmon writes its results here.",
          "types": [
            "tsv"
          ],
          "pattern": "salmon_out/",
          "is_dir": true
        },
        {
          "name": "quant",
          "label": "Abundances",
          "description": "The table of transcript abundances. It is always called quant.sf inside the result folder.",
          "types": [
            "tsv"
          ],
          "derived": {
            "from": "out_dir",
            "suffix": "quant.sf"
          },
          "is_dir": false
        }
      ],
      "params": [
        {
          "id": "libtype",
          "label": "Library type",
          "type": "select",
          "default": "A",
          "options": [
            "A",
            "U",
            "SF",
            "SR"
          ],
          "description": "A detects the type automatically."
        }
      ],
      "command": "salmon quant -i {index} -l {libtype} -r {reads} -p {threads} -o {out_dir}",
      "threads": 4,
      "docs": "https://salmon.readthedocs.io/"
    },
    {
      "id": "featurecounts",
      "name": "featureCounts",
      "description": "Counts reads per gene from alignments and an annotation.",
      "category": "quantification",
      "subcategory": "Gene counts",
      "install": {
        "kind": "conda",
        "package": "subread",
        "channel": "bioconda",
        "version": "2.1.1"
      },
      "inputs": [
        {
          "name": "bams",
          "label": "Alignments",
          "description": "One or more BAM or SAM files. They are counted into one table, one column per file.",
          "types": [
            "bam",
            "sam"
          ],
          "required": true,
          "multiple": true,
          "example": "sorted.bam"
        },
        {
          "name": "annotation",
          "label": "Gene annotation",
          "description": "Gene annotation in GTF format.",
          "types": [
            "gtf"
          ],
          "required": true,
          "multiple": false,
          "example": "genes.gtf"
        }
      ],
      "outputs": [
        {
          "name": "counts",
          "label": "Count table",
          "description": "One row per gene, one column per input file.",
          "types": [
            "tsv"
          ],
          "pattern": "counts.tsv",
          "is_dir": false
        },
        {
          "name": "summary",
          "label": "Counting summary",
          "description": "How many reads were assigned or not. MultiQC reads it. Always the count table's name plus .summary.",
          "types": [
            "txt"
          ],
          "derived": {
            "from": "counts",
            "suffix": ".summary"
          },
          "is_dir": false
        }
      ],
      "params": [
        {
          "id": "feature_type",
          "label": "Feature type",
          "type": "string",
          "default": "exon",
          "description": "The GTF feature that reads are counted on."
        },
        {
          "id": "attribute",
          "label": "Group by attribute",
          "type": "string",
          "default": "gene_id",
          "description": "The GTF attribute that names each counted unit."
        },
        {
          "id": "paired",
          "label": "Paired-end reads",
          "type": "boolean",
          "default": false,
          "flag": "-p --countReadPairs",
          "description": "Count read pairs (fragments) instead of single reads."
        }
      ],
      "command": "featureCounts -T {threads} -a {annotation} -t {feature_type} -g {attribute} {paired} -o {counts} {bams}",
      "threads": 4,
      "docs": "https://subread.sourceforge.net/SubreadUsersGuide.pdf"
    }
  ]
}
